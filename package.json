{
    "name": "pettycash",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.11 <25"
    },
    "scripts": {
        "build": "vite build",
        "check:portability": "node scripts/portability-check.js",
        "dev": "vite build --watch",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint src tests/Frontend",
        "stylelint": "stylelint 'src/**/*.{css,scss,vue}'",
        "test": "vitest run",
        "test:unit": "vitest run",
        "test:e2e": "playwright test",
        "check": "npm run check:portability && npm run typecheck && npm run lint && npm run stylelint && npm run test && npm run build"
    },
    "dependencies": {
        "@nextcloud/axios": "2.6.0",
        "@nextcloud/dialogs": "7.5.0",
        "@nextcloud/initial-state": "3.0.0",
        "@nextcloud/l10n": "3.4.1",
        "@nextcloud/router": "3.2.0",
        "@nextcloud/vue": "9.12.0",
        "pinia": "3.0.4",
        "vue": "3.5.25",
        "vue-router": "4.6.3"
    },
    "devDependencies": {
        "@nextcloud/vite-config": "2.4.0",
        "@playwright/test": "1.57.0",
        "@types/node": "24.10.1",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vue/test-utils": "2.4.6",
        "eslint": "9.39.1",
        "eslint-plugin-vue": "10.6.2",
        "jsdom": "27.2.0",
        "postcss-html": "1.7.0",
        "sass": "1.94.2",
        "stylelint": "16.26.0",
        "stylelint-config-standard-scss": "16.0.0",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.4",
        "vite": "^6.3.5",
        "vite-plugin-node-polyfills": "0.23.0",
        "vitest": "4.0.14",
        "vue-eslint-parser": "10.2.0",
        "vue-tsc": "3.1.5"
    },
    "overrides": {
        "rollup-plugin-node-externals": "8.1.2"
    }
}
