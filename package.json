{
  "name": "pettycash",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11 <25"
  },
  "scripts": {
    "build": "vite build",
    "check:portability": "node scripts/portability-check.js",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests/Frontend",
    "stylelint": "stylelint 'src/**/*.{css,scss,vue}'",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "pretest:e2e": "scripts/dev/opcache-settle",
    "check": "npm run check:openapi && npm run check:portability && npm run check:error-rate && npm run typecheck && npm run lint && npm run stylelint && npm run test && npm run build && npm run check:notices",
    "check:openapi": "scripts/validate-openapi.sh",
    "openapi:write": "scripts/validate-openapi.sh --write",
    "check:error-rate": "node scripts/measure-error-rate.mjs --self-test",
    "measure:error-rate": "node scripts/measure-error-rate.mjs",
    "check:notices": "node scripts/generate-third-party-notices.mjs --check",
    "notices:write": "node scripts/generate-third-party-notices.mjs --write"
  },
  "dependencies": {
    "@nextcloud/axios": "2.6.0",
    "@nextcloud/dialogs": "7.5.0",
    "@nextcloud/initial-state": "3.0.0",
    "@nextcloud/l10n": "3.4.1",
    "@nextcloud/router": "3.2.0",
    "@nextcloud/vue": "9.12.0",
    "pinia": "3.0.4",
    "vue": "3.5.25",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@nextcloud/vite-config": "2.4.0",
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.6.2",
    "jsdom": "27.2.0",
    "openapi-typescript": "^7.13.0",
    "postcss-html": "1.7.0",
    "sass": "1.94.2",
    "stylelint": "16.26.0",
    "stylelint-config-standard-scss": "16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "0.23.0",
    "vitest": "4.0.14",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.1.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "rollup-plugin-node-externals": "8.1.2"
  }
}
