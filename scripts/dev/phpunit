#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Local, gitignored credentials for the live-HTTP OCS contract tests.
# Source: .env.example documents every variable.
ENV_FILE="$REPO_ROOT/.env.testing"
declare -a ENV_ARGS=()
if [ -f "$ENV_FILE" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    key="${line%%=*}"
    value="${line#*=}"
    if [ "$key" = "$value" ]; then
      continue
    fi
    # Strip optional surrounding quotes and surrounding whitespace.
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value%\"}"; value="${value#\"}"
    value="${value%\'}"; value="${value#\'}"
    ENV_ARGS+=(--env "$key=$value")
  done < "$ENV_FILE"
fi

exec "$SCRIPT_DIR/in-container" \
  "${ENV_ARGS[@]+"${ENV_ARGS[@]}"}" \
  php vendor/bin/phpunit \
  --do-not-cache-result \
  "$@"
