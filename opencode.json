{
  "$schema": "https://opencode.ai/config.json",

  "model": "ollama/qwen3-coder:30b",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama on Windows",
      "options": {
        "baseURL": "http://192.168.183.1:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3 Coder 30B"
        }
      }
    }
  },

  "lsp": {
    "php intelephense": {
      "disabled": true
    },
    "pettycash-php": {
      "command": [
        "intelephense",
        "--stdio"
      ],
      "extensions": [
        ".php"
      ],
      "initialization": {
        "clearCache": false,
        "intelephense": {
          "environment": {
            "phpVersion": "8.5.9",
            "includePaths": [
              "/home/ubuntu/.cache/pettycash-lsp/vendor"
            ]
          }
        }
      }
    }
  }
}
