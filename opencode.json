{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "php intelephense": {
      "disabled": true
    },
    "pettycash-php": {
      "command": [
        "intelephense",
        "--stdio"
      ],
      "extensions": [
        ".php"
      ],
      "initialization": {
        "clearCache": false,
        "intelephense": {
          "environment": {
            "phpVersion": "8.5.9",
            "includePaths": [
              "/home/ubuntu/.cache/pettycash-lsp/vendor"
            ]
          }
        }
      }
    }
  }
}
